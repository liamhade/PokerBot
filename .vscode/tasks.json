{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "C/C++: g++.exe for main.cpp",
            "command": "g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${workspaceFolder}\\src\\*.cpp",
                "-o",
                "${workspaceFolder}\\bin\\main.exe"
            ],
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by user."
        },

        // ---------- Build each test file into bin\<test_name>.exe ----------
        {
            "type": "shell",
            "label": "build test_HandEvaluator",
            "command": "g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${workspaceFolder}\\src\\Action.cpp",
                "${workspaceFolder}\\src\\CardHandler.cpp",
                "${workspaceFolder}\\src\\ComputerPlayer.cpp",
                "${workspaceFolder}\\src\\DeckHandler.cpp",
                "${workspaceFolder}\\src\\HandEvaluator.cpp",
                "${workspaceFolder}\\src\\HumanPlayer.cpp",
                "${workspaceFolder}\\src\\InputHandler.cpp",
                "${workspaceFolder}\\src\\Poker.cpp",
                "${workspaceFolder}\\src\\PotDispersal.cpp",
                "${workspaceFolder}\\src\\PredictionEngine.cpp",
                "${workspaceFolder}\\tests\\test_HandEvaluator.cpp",
                "-o",
                "${workspaceFolder}\\bin\\test_HandEvaluator.exe"
            ],
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build"
        },
        {
            "type": "shell",
            "label": "build test_PotDispersal",
            "command": "g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${workspaceFolder}\\src\\Action.cpp",
                "${workspaceFolder}\\src\\CardHandler.cpp",
                "${workspaceFolder}\\src\\ComputerPlayer.cpp",
                "${workspaceFolder}\\src\\DeckHandler.cpp",
                "${workspaceFolder}\\src\\HandEvaluator.cpp",
                "${workspaceFolder}\\src\\HumanPlayer.cpp",
                "${workspaceFolder}\\src\\InputHandler.cpp",
                "${workspaceFolder}\\src\\Poker.cpp",
                "${workspaceFolder}\\src\\PotDispersal.cpp",
                "${workspaceFolder}\\src\\PredictionEngine.cpp",
                "${workspaceFolder}\\tests\\test_PotDispersal.cpp",
                "-o",
                "${workspaceFolder}\\bin\\test_PotDispersal.exe"
            ],
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build"
        },
        {
            "type": "shell",
            "label": "build test_PredictionEngine",
            "command": "g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${workspaceFolder}\\src\\Action.cpp",
                "${workspaceFolder}\\src\\CardHandler.cpp",
                "${workspaceFolder}\\src\\ComputerPlayer.cpp",
                "${workspaceFolder}\\src\\DeckHandler.cpp",
                "${workspaceFolder}\\src\\HandEvaluator.cpp",
                "${workspaceFolder}\\src\\HumanPlayer.cpp",
                "${workspaceFolder}\\src\\InputHandler.cpp",
                "${workspaceFolder}\\src\\Poker.cpp",
                "${workspaceFolder}\\src\\PotDispersal.cpp",
                "${workspaceFolder}\\src\\PredictionEngine.cpp",
                "${workspaceFolder}\\tests\\test_PredictionEngine.cpp",
                "-o",
                "${workspaceFolder}\\bin\\test_PredictionEngine.exe"
            ],
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build"
        },

        // ---------- Build + run each test file ----------
        {
            "type": "process",
            "label": "run test_HandEvaluator",
            "command": "${workspaceFolder}\\bin\\test_HandEvaluator.exe",
            "dependsOn": "build test_HandEvaluator",
            "problemMatcher": [],
            "group": "test"
        },
        {
            "type": "process",
            "label": "run test_PotDispersal",
            "command": "${workspaceFolder}\\bin\\test_PotDispersal.exe",
            "dependsOn": "build test_PotDispersal",
            "problemMatcher": [],
            "group": "test"
        },
        {
            "type": "process",
            "label": "run test_PredictionEngine",
            "command": "${workspaceFolder}\\bin\\test_PredictionEngine.exe",
            "dependsOn": "build test_PredictionEngine",
            "problemMatcher": [],
            "group": "test"
        },

        // ---------- Build + run every test file, one after another ----------
        {
            "label": "run all tests",
            "dependsOrder": "sequence",
            "dependsOn": [
                "run test_HandEvaluator",
                "run test_PotDispersal",
                "run test_PredictionEngine"
            ],
            "problemMatcher": [],
            "group": {
                "kind": "test",
                "isDefault": true
            }
        }
    ]
}
